{
  "name": "traverse",
  "version": "0.8.0",
  "private": true,
  "description": "Explore a federated GraphQL graph from the frontend, built on WunderGraph Cosmo.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "subgraphs/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "build:web": "npm run build -w @traverse/web",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "test:demo": "BASE_PATH=/traverse npm run build:web && BASE_PATH=/traverse npm run test:e2e",
    "generate:tokens": "node scripts/generate-tokens.ts",
    "generate:demo": "node scripts/generate-demo-graph.ts",
    "check:deps": "depcruise \"{packages,subgraphs,apps,infra,scripts}/**/*.{ts,tsx}\" --config .dependency-cruiser.cjs",
    "check:dupes": "jscpd --config .jscpd.json",
    "check:unused": "knip",
    "check:hygiene": "node scripts/repo-check.ts hygiene",
    "check:traceability": "node scripts/repo-check.ts traceability",
    "check:progress": "node scripts/check-progress.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:deps && npm run check:dupes && npm run check:unused && npm run check:hygiene && npm run check:traceability && npm run check:progress && npm run test:coverage && npm run build:web && npm run test:integration && npm run test:e2e && npm run test:demo",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@traverse/design-tokens": "*",
    "@traverse/graph-core": "*",
    "@traverse/repo-checks": "*",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "jsdom": "^31.0.0",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@wundergraph/composition": {
      "@graphql-tools/utils": "^12.1.0"
    }
  }
}

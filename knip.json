{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "router/test/**/*.test.ts"],
      "project": ["scripts/**", "router/**/*.ts"]
    },
    "apps/*": {
      "project": ["src/**", "test/**"]
    },
    "packages/*": {
      "project": ["src/**", "test/**"]
    },
    "subgraphs/*": {
      "entry": ["src/main.ts"],
      "project": ["src/**", "test/**"]
    },
    "packages/subgraph-kit": {
      "entry": ["test/integration/fixtures/*.ts"],
      "project": ["src/**", "test/**"]
    }
  }
}

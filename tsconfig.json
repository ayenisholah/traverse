{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "scripts/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/*.config.ts",
    "subgraphs/*/src/**/*.ts",
    "subgraphs/*/test/**/*.ts",
    "router/test/**/*.ts",
    "*.config.ts"
  ]
}
